# CivicAI environment template. Copy to .env and fill in.
# NEVER commit a populated .env - see .gitignore.

# ---- Host port overrides (docker compose only) ----
# Set these if 5432/6379/9000/8000 are already taken on your machine.
CIVICAI_POSTGRES_PORT=5432
CIVICAI_REDIS_PORT=6379
CIVICAI_MINIO_PORT=9000
CIVICAI_MINIO_CONSOLE_PORT=9001
CIVICAI_API_PORT=8000

# ---- Core ----
CIVICAI_ENV=dev                  # dev | ci | prod
CIVICAI_LOG_LEVEL=INFO

# ---- Sentinel (PRD section 8.3) ----
CIVICAI_SENTINEL_MODE=strict     # strict | permissive | shadow
CIVICAI_SENTINEL_DEADLINE_MS=2000

# ---- Bus (PRD section 9.1) ----
CIVICAI_BUS_BACKEND=memory       # memory | redis
CIVICAI_REDIS_URL=redis://localhost:6379/0

# ---- State (P1) ----
CIVICAI_DATABASE_URL=postgresql://civicai:civicai@localhost:5432/civicai

# ---- Object store (P1) ----
CIVICAI_S3_ENDPOINT=http://localhost:9000
CIVICAI_S3_BUCKET=civicai-media
CIVICAI_S3_ACCESS_KEY=
CIVICAI_S3_SECRET_KEY=

# ---- LLM provider (PRD section 6.2) ----
# No agent imports a vendor SDK directly; everything goes through common/llm/provider.py.
# Leave unset to run with the deterministic test double (tests only - agents fail loudly in dev/prod).
CIVICAI_LLM_PROVIDER=            # watsonx | anthropic | openai | (empty = unconfigured)
CIVICAI_WATSONX_API_KEY=
CIVICAI_WATSONX_PROJECT_ID=
CIVICAI_WATSONX_URL=
