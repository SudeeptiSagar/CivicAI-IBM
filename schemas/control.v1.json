{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civicai.dev/schemas/control.v1.json",
  "title": "CivicAI control.* family v1",
  "description": "Operational command addressed to a single agent. PRD 9.3.",
  "allOf": [
    {
      "$ref": "https://civicai.dev/schemas/envelope.v1.json"
    }
  ],
  "required": [
    "payload"
  ],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string",
          "enum": [
            "pause",
            "resume",
            "reload_config",
            "replay"
          ]
        },
        "params": {
          "type": "object"
        }
      }
    }
  }
}
