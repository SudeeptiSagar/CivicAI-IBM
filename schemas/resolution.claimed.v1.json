{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civicai.dev/schemas/resolution.claimed.v1.json",
  "title": "CivicAI resolution.claimed v1",
  "description": "Department claims an incident is resolved. PRD 7/A6. Producer: dashboard.",
  "allOf": [
    {
      "$ref": "https://civicai.dev/schemas/envelope.v1.json"
    }
  ],
  "required": [
    "topic",
    "payload"
  ],
  "properties": {
    "topic": {
      "const": "resolution.claimed"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolution_id",
        "incident_id",
        "claimed_by",
        "claimed_at"
      ],
      "properties": {
        "resolution_id": {
          "$ref": "https://civicai.dev/schemas/envelope.v1.json#/$defs/uuid"
        },
        "incident_id": {
          "$ref": "https://civicai.dev/schemas/envelope.v1.json#/$defs/uuid"
        },
        "claimed_by": {
          "type": "string",
          "minLength": 1
        },
        "claimed_at": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "claim_media_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
