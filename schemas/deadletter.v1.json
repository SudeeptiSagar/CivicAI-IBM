{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civicai.dev/schemas/deadletter.v1.json",
  "title": "CivicAI deadletter v1",
  "description": "Terminal failure after retry exhaustion. PRD 9.4. Producer: any.",
  "allOf": [
    {
      "$ref": "https://civicai.dev/schemas/envelope.v1.json"
    }
  ],
  "required": [
    "topic",
    "payload"
  ],
  "properties": {
    "topic": {
      "const": "deadletter"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "attempts",
        "error_chain",
        "original_envelope",
        "failed_at"
      ],
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "attempts": {
          "type": "integer",
          "minimum": 1
        },
        "error_chain": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "original_envelope": {
          "type": "object"
        },
        "failed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
